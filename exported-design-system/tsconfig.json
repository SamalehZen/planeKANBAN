{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@plane/propel/*": ["packages/propel/src/*"],
      "@plane/propel": ["packages/propel/src"],
      "@plane/ui/*": ["packages/ui/src/*"],
      "@plane/ui": ["packages/ui/src"],
      "@plane/types/*": ["packages/types/src/*"],
      "@plane/types": ["packages/types/src"],
      "@plane/constants/*": ["packages/constants/src/*"],
      "@plane/constants": ["packages/constants/src"],
      "@plane/hooks/*": ["packages/hooks/src/*"],
      "@plane/hooks": ["packages/hooks/src"],
      "@plane/utils/*": ["packages/utils/src/*"],
      "@plane/utils": ["packages/utils/src"],
      "@plane/editor/*": ["packages/editor/src/*"],
      "@plane/editor": ["packages/editor/src"],
      "@plane/i18n/*": ["packages/i18n/src/*"],
      "@plane/i18n": ["packages/i18n/src"],
      "@plane/services/*": ["packages/services/src/*"],
      "@plane/services": ["packages/services/src"],
      "@plane/shared-state/*": ["packages/shared-state/src/*"],
      "@plane/shared-state": ["packages/shared-state/src"],
      "@plane/tailwind-config/*": ["packages/tailwind-config/*"],
      "@plane/tailwind-config": ["packages/tailwind-config"]
    }
  },
  "include": ["packages/**/*", "apps/**/*"],
  "exclude": ["node_modules", "**/dist/**"]
}
