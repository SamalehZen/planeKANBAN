# ===================
# Django Settings
# ===================
DEBUG=0
DJANGO_SETTINGS_MODULE=plane.settings.production

# Secret Key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-secret-key-here

# ===================
# Database (Neon)
# ===================
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/plane?sslmode=require

# ===================
# Redis (Upstash)
# ===================
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ===================
# Storage (Cloudflare R2)
# ===================
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_ENDPOINT_URL=https://xxx.r2.cloudflarestorage.com
AWS_S3_BUCKET_NAME=plane-uploads
AWS_REGION=auto

# ===================
# CORS & Security
# ===================
CORS_ALLOWED_ORIGINS=https://plane-web.onrender.com,https://plane-admin.onrender.com,https://plane-space.onrender.com
WEB_URL=https://plane-web.onrender.com
ADMIN_URL=https://plane-admin.onrender.com
SPACE_URL=https://plane-space.onrender.com

# ===================
# Email (Optional)
# ===================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ===================
# AI (LLM Configuration)
# ===================
# Default provider is Xiaomi MiMo (mimo-v2-flash) - 2.6x faster, 97.5% lower cost
# Supported providers: mimo, openai, gemini, anthropic
LLM_PROVIDER=mimo
LLM_API_KEY=your-mimo-api-key-here
LLM_MODEL=mimo-v2-flash

# Legacy OpenAI settings (deprecated - use LLM_* instead)
OPENAI_API_KEY=sk-xxx
GPT_ENGINE=gpt-4

# ===================
# OAuth (Optional)
# ===================
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===================
# Speech-to-Text (Optional - AssemblyAI)
# ===================
ASSEMBLYAI_API_KEY=
